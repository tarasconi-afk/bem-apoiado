---
interface Props {
  nums: number[];
}
const { nums } = Astro.props;
---
{nums.length > 0 && (
  <sup class="cite">{nums.map((n, i) => <>{i > 0 && ','}<a href={`#fonte-${n}`} aria-label={`Fonte ${n}`}>{n}</a></>)}</sup>
)}
<style>
  /* O estilo mora aqui: o CSS de cada página do Astro é isolado e não alcança este componente. */
  /* Discreto de propósito: quase invisível na leitura, mas presente (e clicável) para quem audita. */
  .cite { margin-left: 0.08rem; white-space: nowrap; line-height: 0; font: 500 0.62rem/0 var(--sans); color: #a7b1ab; vertical-align: 0.5em; }
  .cite a { color: inherit; text-decoration: none; padding: 0 0.05rem; }
  .cite a:hover, .cite a:focus-visible { color: var(--brand); text-decoration: underline; }
</style>
