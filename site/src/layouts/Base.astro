---
import { BRAND, INDEXABLE } from '../lib/content';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const robots = INDEXABLE && !noindex ? 'index,follow' : 'noindex,nofollow';
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="pt_BR" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect x='3' y='17' width='26' height='9' rx='4' fill='%232d5b4f'/%3E%3Crect x='6' y='8' width='20' height='7' rx='3.5' fill='%2390b3a6'/%3E%3C/svg%3E" />
    <style is:global>
      :root {
        --paper: #faf8f4;
        --card: #ffffff;
        --ink: #1f2421;
        --muted: #5f665f;
        --line: #e4ded3;
        --accent: #2d5b4f;
        --accent-soft: #e9f1ed;
        --warn: #9a6514;
        --warn-soft: #fbf3e2;
        --serif: 'Iowan Old Style', 'Charter', 'Palatino Linotype', Georgia, serif;
        --sans: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
        --measure: 42rem;
      }
      * { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; scroll-padding-top: 1rem; }
      body { margin: 0; background: var(--paper); color: var(--ink); font: 1.0625rem/1.7 var(--sans); }
      a { color: var(--accent); text-underline-offset: 2px; }
      .wrap { max-width: var(--measure); margin: 0 auto; padding: 0 1rem; }

      .site-header { border-bottom: 1px solid var(--line); background: var(--paper); }
      .site-header .wrap { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding-block: 0.9rem; }
      .brand { display: inline-flex; align-items: center; gap: 0.55rem; color: var(--ink); text-decoration: none; font: 700 1.15rem/1 var(--serif); letter-spacing: -0.01em; }
      .brand svg { flex: none; }
      .site-nav a { color: var(--muted); text-decoration: none; font-size: 0.92rem; margin-left: 1.1rem; }
      .site-nav a:hover { color: var(--accent); }

      h1, h2, h3 { font-family: var(--serif); color: var(--ink); letter-spacing: -0.01em; }
      h1 { font-size: clamp(1.85rem, 5vw, 2.5rem); line-height: 1.15; margin: 0.4rem 0 0.8rem; }
      h2 { font-size: 1.45rem; line-height: 1.25; margin: 2.6rem 0 0.8rem; }
      p { margin: 0 0 1rem; }

      .site-footer { margin-top: 4rem; border-top: 1px solid var(--line); color: var(--muted); font-size: 0.88rem; }
      .site-footer .wrap { padding-block: 2rem 3rem; }
      .site-footer p { margin-bottom: 0.7rem; }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">
          <svg width="26" height="26" viewBox="0 0 32 32" aria-hidden="true"><rect x="3" y="17" width="26" height="9" rx="4" fill="#2d5b4f" /><rect x="6" y="8" width="20" height="7" rx="3.5" fill="#90b3a6" /></svg>
          {BRAND}
        </a>
        <nav class="site-nav"><a href="/">Guias</a><a href="/como-trabalhamos/">Como trabalhamos</a></nav>
      </div>
    </header>
    <main class="wrap"><slot /></main>
    <footer class="site-footer">
      <div class="wrap">
        <p><strong>Como trabalhamos:</strong> comparamos o que fabricantes, normas técnicas e órgãos reguladores publicam. Não testamos produtos fisicamente; dado sem fonte não entra. <a href="/como-trabalhamos/">Saiba mais</a>.</p>
        <p>Como participante do Programa de Associados da Amazon, somos remunerados pelas compras qualificadas feitas por meio dos nossos links. Isso não muda o que escrevemos.</p>
        <p>Nada aqui substitui orientação de profissional de saúde.</p>
      </div>
    </footer>
  </body>
</html>
