---
import Base from '../layouts/Base.astro';
import { BRAND, publicPages } from '../lib/content';
const pages = publicPages();
---
<Base title={`${BRAND}: colchão, travesseiro e cadeira explicados com fonte`} description="Decisões de compra sobre sono e home office, explicadas com o que fabricantes, normas técnicas e órgãos reguladores publicam.">
  <section class="hero">
    <h1>Escolha com o que está escrito, não com o que é prometido.</h1>
    <p>Guias sobre colchão, travesseiro e cadeira feitos a partir de normas técnicas, órgãos reguladores e fichas de fabricantes. Cada afirmação aponta para o trecho exato da fonte.</p>
  </section>
  <section>
    <h2>Guias</h2>
    {pages.length === 0 ? (
      <p class="empty">Primeiros guias em preparação.</p>
    ) : (
      <ul class="cards">
        {pages.map((p) => (
          <li>
            <a href={`/${p.slug}/`}>
              <span class="card-kicker">Guia de decisão</span>
              <span class="card-title">{p.title}</span>
              <span class="card-desc">{p.description}</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</Base>
<style>
  .hero { padding: 3rem 0 1rem; }
  .hero h1 { max-width: 34rem; }
  .hero p { color: var(--muted); font-size: 1.1rem; max-width: 36rem; }
  .cards { list-style: none; padding: 0; margin: 0; display: grid; gap: 1rem; }
  .cards a { display: block; padding: 1.1rem 1.25rem; border: 1px solid var(--line); border-radius: 12px; background: var(--card); color: var(--ink); text-decoration: none; transition: border-color .15s; }
  .cards a:hover { border-color: var(--accent); }
  .card-kicker { display: block; color: var(--accent); font-size: 0.75rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; }
  .card-title { display: block; font: 700 1.2rem/1.3 var(--serif); margin: .3rem 0; }
  .card-desc { display: block; color: var(--muted); font-size: .95rem; }
  .empty { color: var(--muted); }
</style>
