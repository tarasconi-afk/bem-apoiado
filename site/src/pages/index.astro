---
import Base from '../layouts/Base.astro';
import KindImage from '../components/KindImage.astro';
import GuideCards from '../components/GuideCards.astro';
import { BRAND, CATEGORIES, categoryOf, homeSorted, href, NICHE, publicPages, THEME } from '../lib/content';

const pages = homeSorted(publicPages());
// Home por categoria (até 6 guias cada; o resto na página da categoria); sem categoria vai para "Outros guias".
const groups = [
  ...CATEGORIES.map((c) => ({ id: c.id, label: c.label, all: pages.filter((p) => categoryOf(p)?.id === c.id) })),
  { id: '', label: 'Outros guias', all: pages.filter((p) => !categoryOf(p)) },
].filter((g) => g.all.length).map((g) => ({ ...g, pages: g.all.slice(0, 6), total: g.all.length }));
const site = Astro.site!.href;
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: BRAND, url: site, inLanguage: 'pt-BR' },
  { '@context': 'https://schema.org', '@type': 'Organization', name: BRAND, url: site, logo: new URL('/apple-touch-icon.png', site).href },
];
---
<Base title={`${BRAND}: ${NICHE.category_label.toLowerCase()} explicado com fonte`} description={`Decisões de ${NICHE.scope}, explicadas com o que fabricantes, normas técnicas e órgãos reguladores publicam.`.slice(0, 158)} jsonLd={jsonLd}>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <span class="chip">{NICHE.category_label}</span>
        <h1>{NICHE.site_tagline}</h1>
        <p class="lede">{NICHE.site_intro}</p>
        <a class="btn" href="#guias">{THEME.texts.hero_button} <span aria-hidden="true">→</span></a>
      </div>
      <figure class="hero-art">
        <KindImage id="capa" class="hero-img" sizes="(min-width: 60rem) 36rem, 92vw" eager />
        <figcaption><a href="#nota-imagens" aria-label="Sobre a imagem">*</a></figcaption>
      </figure>
    </div>
  </section>

  <section class="how" aria-labelledby="como">
    <div class="wrap">
      <h2 id="como" class="sr-only">Como fazemos</h2>
      <ol class="steps">
        <li><span class="n">1</span><h3>Fontes primárias</h3><p>Lemos o que normas, reguladores e fabricantes publicam. Blog de opinião e ranking pago não entram.</p></li>
        <li><span class="n">2</span><h3>Trecho exato</h3><p>Cada afirmação aponta para o trecho literal da fonte, guardado na data da consulta.</p></li>
        <li><span class="n">3</span><h3>Você decide</h3><p>Em vez de "o melhor", mostramos o que conferir e em que situação cada tipo faz sentido.</p></li>
      </ol>
    </div>
  </section>

  <section id="guias" class="guides" aria-labelledby="guias-t">
    <div class="wrap">
      <h2 id="guias-t" class="sr-only">Guias</h2>
      {pages.length === 0 && <p class="empty">Primeiros guias em preparação.</p>}
      {groups.map((g) => (
        <div class="group">
          <div class="group-head">
            <h2>{g.label}</h2>
            {g.id && g.total > g.pages.length && <a href={href(`/categoria/${g.id}/`)}>Ver os {g.total} guias <span aria-hidden="true">→</span></a>}
            {g.id && g.total <= g.pages.length && <a href={href(`/categoria/${g.id}/`)}>Página da categoria <span aria-hidden="true">→</span></a>}
          </div>
          <GuideCards pages={g.pages} />
        </div>
      ))}
    </div>
  </section>
</Base>
<style>
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .hero { background: linear-gradient(180deg, var(--brand-soft) 0%, var(--bg) 100%); border-bottom: 1px solid var(--line); }
  .hero-grid { display: grid; gap: 2.5rem; align-items: center; padding-block: 3.5rem 3rem; }
  @media (min-width: 60rem) { .hero-grid { grid-template-columns: 1.05fr 1fr; padding-block: 5rem 4.5rem; } }
  .hero-copy h1 { max-width: 34rem; }
  .lede { color: var(--muted); font-size: 1.15rem; max-width: 34rem; margin-bottom: 1.6rem; }
  .hero-art { margin: 0; }
  .hero-art :global(.hero-img) { display: block; width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 24px; box-shadow: var(--shadow); }
  .hero-art figcaption { margin-top: 0.3rem; font-size: 0.8rem; text-align: right; }
  .hero-art figcaption a { color: var(--muted); text-decoration: none; }

  .how { padding-block: 3rem 1rem; }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); }
  .steps li { padding: 1.4rem 1.4rem 0.6rem; border-radius: var(--radius); background: var(--surface); border: 1px solid var(--line); }
  .steps h3 { margin: 0.7rem 0 0.35rem; }
  .steps p { color: var(--muted); font-size: 0.98rem; }
  .n { display: inline-grid; place-items: center; width: 2rem; height: 2rem; border-radius: 10px; background: var(--amber-soft); color: var(--warn); font-weight: 700; }

  .group { margin-top: 2.5rem; }
  .group-head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; flex-wrap: wrap; margin-bottom: 1rem; }
  .group-head h2 { margin: 0; }
  .group-head a { font-weight: 600; text-decoration: none; }
  .empty { color: var(--muted); }
</style>
