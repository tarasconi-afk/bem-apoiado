---
import Base from '../layouts/Base.astro';
import Illustration from '../components/Illustration.astro';
import { BRAND, fmtDate, homeIllustrations, KIND_LABEL, NICHE, publicPages, sourcesCount } from '../lib/content';

const pages = publicPages().sort((a, b) => b.updated_at.localeCompare(a.updated_at));
const art = homeIllustrations(pages);
const kicker = (t: string) => (t === 'decision_compare' ? 'Guia de decisão' : t === 'buying_guide' ? 'Guia de compra' : 'Explicação');
const site = Astro.site!.href;
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: BRAND, url: site, inLanguage: 'pt-BR' },
  { '@context': 'https://schema.org', '@type': 'Organization', name: BRAND, url: site, logo: new URL('/apple-touch-icon.png', site).href },
];
---
<Base title={`${BRAND}: ${NICHE.category_label.toLowerCase()} explicado com fonte`} description={`Decisões de ${NICHE.scope}, explicadas com o que fabricantes, normas técnicas e órgãos reguladores publicam.`.slice(0, 158)} jsonLd={jsonLd}>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <span class="chip">{NICHE.category_label}</span>
        <h1>{NICHE.site_tagline}</h1>
        <p class="lede">{NICHE.site_intro}</p>
        <a class="btn" href="#guias">Ver os guias <span aria-hidden="true">→</span></a>
      </div>
      <figure class="hero-art" aria-hidden="true">
        <div class="hero-panel"><Illustration kind="molas_ensacadas" /></div>
        <span class="tag t1"><b>✓</b> Norma técnica</span>
        <span class="tag t2"><b>✓</b> Órgão regulador</span>
        <span class="tag t3"><b>✓</b> Ficha do fabricante</span>
      </figure>
    </div>
  </section>

  <section class="how" aria-labelledby="como">
    <div class="wrap">
      <h2 id="como" class="sr-only">Como fazemos</h2>
      <ol class="steps">
        <li><span class="n">1</span><h3>Fontes primárias</h3><p>Lemos o que normas, reguladores e fabricantes publicam. Blog de opinião e ranking pago não entram.</p></li>
        <li><span class="n">2</span><h3>Trecho exato</h3><p>Cada afirmação aponta para o trecho literal da fonte, guardado na data da consulta.</p></li>
        <li><span class="n">3</span><h3>Você decide</h3><p>Em vez de "o melhor", mostramos o que conferir e em que situação cada tipo faz sentido.</p></li>
      </ol>
    </div>
  </section>

  <section id="guias" class="guides" aria-labelledby="guias-t">
    <div class="wrap">
      <h2 id="guias-t">Guias</h2>
      {pages.length === 0 ? (
        <p class="empty">Primeiros guias em preparação.</p>
      ) : (
        <ul class="cards">
          {pages.map((p) => (
            <li>
              <a href={`/${p.slug}/`}>
                <div class="card-art"><Illustration kind={art.get(p.slug)!} /></div>
                <div class="card-body">
                  <span class="card-kicker">{kicker(p.page_type)}{art.get(p.slug) !== 'outro' && ` · ${KIND_LABEL[art.get(p.slug)!]}`}</span>
                  <span class="card-title">{p.title}</span>
                  <span class="card-desc">{p.description}</span>
                  <span class="card-meta">{sourcesCount(p)} fontes · atualizado em {fmtDate(p.updated_at)}</span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
</Base>
<style>
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .hero { background: linear-gradient(180deg, var(--brand-soft) 0%, var(--bg) 100%); border-bottom: 1px solid var(--line); }
  .hero-grid { display: grid; gap: 2.5rem; align-items: center; padding-block: 3.5rem 3rem; }
  @media (min-width: 60rem) { .hero-grid { grid-template-columns: 1.05fr 1fr; padding-block: 5rem 4.5rem; } }
  .hero-copy h1 { max-width: 34rem; }
  .lede { color: var(--muted); font-size: 1.15rem; max-width: 34rem; margin-bottom: 1.6rem; }
  .hero-art { position: relative; margin: 0; }
  .hero-panel { padding: 2rem 1.5rem 1.2rem; border-radius: 24px; background: var(--surface); box-shadow: var(--shadow); border: 1px solid var(--line); }
  .tag { position: absolute; display: inline-flex; gap: 0.4rem; align-items: center; padding: 0.45rem 0.75rem; border-radius: 12px; background: var(--surface); border: 1px solid var(--line); box-shadow: var(--shadow); font-size: 0.85rem; font-weight: 600; white-space: nowrap; }
  .tag b { display: inline-grid; place-items: center; width: 1.2rem; height: 1.2rem; border-radius: 50%; background: var(--brand); color: #fff; font-size: 0.7rem; }
  .t1 { top: -0.9rem; left: 1rem; }
  .t2 { top: 38%; right: -0.6rem; }
  .t3 { bottom: -1rem; left: 22%; }
  @media (max-width: 40rem) { .t2 { right: 0.5rem; } }

  .how { padding-block: 3rem 1rem; }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); }
  .steps li { padding: 1.4rem 1.4rem 0.6rem; border-radius: var(--radius); background: var(--surface); border: 1px solid var(--line); }
  .steps h3 { margin: 0.7rem 0 0.35rem; }
  .steps p { color: var(--muted); font-size: 0.98rem; }
  .n { display: inline-grid; place-items: center; width: 2rem; height: 2rem; border-radius: 10px; background: var(--amber-soft); color: var(--warn); font-weight: 700; }

  .guides h2 { margin-top: 2.5rem; }
  .cards { list-style: none; padding: 0; margin: 0; display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 21rem), 1fr)); }
  .cards a { display: flex; flex-direction: column; height: 100%; border: 1px solid var(--line); border-radius: 20px; background: var(--surface); color: var(--ink); text-decoration: none; overflow: hidden; transition: box-shadow 0.2s, transform 0.2s, border-color 0.2s; }
  .cards a:hover { box-shadow: var(--shadow); transform: translateY(-2px); border-color: #cfd9d3; }
  .card-art { padding: 1.4rem 1.6rem 0.6rem; background: var(--sand); }
  .card-body { display: flex; flex-direction: column; gap: 0.4rem; padding: 1.2rem 1.4rem 1.4rem; flex: 1; }
  .card-kicker { color: var(--brand); font-size: 0.74rem; font-weight: 650; letter-spacing: 0.07em; text-transform: uppercase; }
  .card-title { font: 600 1.3rem/1.25 var(--display); letter-spacing: -0.01em; }
  .card-desc { color: var(--muted); font-size: 0.96rem; }
  .card-meta { margin-top: auto; padding-top: 0.6rem; color: var(--muted); font-size: 0.82rem; }
  .empty { color: var(--muted); }
</style>
