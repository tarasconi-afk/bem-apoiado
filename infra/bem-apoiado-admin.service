[Unit]
Description=Bem Apoiado: painel admin (127.0.0.1:8787, senha no Caddy)
After=network-online.target
[Service]
User=bemapoiado
WorkingDirectory=/opt/bem-apoiado/repo
Environment=HOME=/opt/bem-apoiado
# Lê os dados da cópia só de leitura do main; ações rodam na cópia de trabalho.
Environment=BEM_ROOT=/opt/bem-apoiado/view
Environment=BEM_REPO=/opt/bem-apoiado/repo
EnvironmentFile=/etc/bem-apoiado/env
# Mesmos tetos do ciclo, só para o painel exibir.
Environment=BEM_DAILY_CREDIT_CAP=250
Environment=BEM_CYCLE_BUDGET=60
ExecStart=/usr/bin/npm run -s engine -- admin
# Sai sozinho quando o main traz código novo; o systemd sobe de novo com ele.
Restart=always
RestartSec=3
[Install]
WantedBy=multi-user.target
