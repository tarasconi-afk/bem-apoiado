[Unit]
Description=Bem Apoiado: um ciclo do piloto automático
After=network-online.target
[Service]
Type=oneshot
User=bemapoiado
WorkingDirectory=/opt/bem-apoiado/repo
Environment=HOME=/opt/bem-apoiado
# Teto diário somado entre ciclos (2 por dia). ~40 créditos por tentativa de página.
Environment=BEM_DAILY_CREDIT_CAP=100
ExecStart=/opt/bem-apoiado/repo/scripts/cycle.sh
TimeoutStartSec=3h
