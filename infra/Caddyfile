srv2079501.hstgr.cloud {
	encode zstd gzip
	# Ambiente temporário: nunca indexar.
	header X-Robots-Tag "noindex, nofollow"
	header -Server

	redir /painel /painel/
	# Senha conferida pelo próprio painel (admin.ts), que permite trocá-la pela tela.
	handle_path /painel/* {
		header Cache-Control "no-store"
		reverse_proxy 127.0.0.1:8787
	}

	handle {
		root * /var/www/bem-apoiado
		@assets path /_astro/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
}
