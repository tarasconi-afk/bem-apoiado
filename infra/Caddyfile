srv2079501.hstgr.cloud {
	encode zstd gzip
	# Ambiente temporário: nunca indexar.
	header X-Robots-Tag "noindex, nofollow"
	header -Server

	# O painel mudou para admin.bemapoiado.com (26/10); o endereço antigo leva para lá, com o mesmo caminho.
	redir /painel https://admin.bemapoiado.com/ 301
	handle_path /painel/* {
		redir https://admin.bemapoiado.com{uri} 301
	}

	handle {
		root * /var/www/bem-apoiado
		@assets path /_astro/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
}

# Painel do motor. Senha conferida pelo próprio painel (admin.ts), que permite trocá-la pela tela.
admin.bemapoiado.com {
	encode zstd gzip
	header X-Robots-Tag "noindex, nofollow"
	header -Server
	header Cache-Control "no-store"
	reverse_proxy 127.0.0.1:8787
}

# Contador de visitas: só recebe POST /c do site (sem cookie, sem IP guardado). Nada mais é servido aqui.
t.bemapoiado.com {
	header -Server
	header X-Robots-Tag "noindex, nofollow"
	@hit {
		method POST
		path /c
	}
	handle @hit {
		reverse_proxy 127.0.0.1:8788
	}
	# O Google lê o endereço no script do contador e tenta abrir com GET (26/10: "Não encontrado (404)" no Search
	# Console). Responde vazio, com o noindex acima: some do relatório de erros.
	handle /c {
		respond 204
	}
	handle {
		respond 404
	}
}
