# Endereço único: o site temporário (*.hostingersite.com) e o www redirecionam (301) para o domínio.
# Assim o Google nunca vê duas cópias do mesmo conteúdo.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} \.hostingersite\.com$ [NC,OR]
  RewriteCond %{HTTP_HOST} ^www\.bemapoiado\.com$ [NC]
  RewriteRule ^ https://bemapoiado.com%{REQUEST_URI} [R=301,L]
</IfModule>

# robots.txt e sitemap mudam com o site: a CDN não pode segurar versão velha (21/10: robots.txt antigo
# ficou em cache bloqueando o Google depois que a indexação foi ligada).
<IfModule mod_headers.c>
  <FilesMatch "^(robots\.txt|sitemap\.xml)$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>
</IfModule>
